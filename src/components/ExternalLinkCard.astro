---
import { Icon, LinkCard } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

// Mirrors LinkCard's own props (title, description?, anchor attributes) so the
// spread below stays valid if Starlight changes them.
type Props = ComponentProps<typeof LinkCard>;

const props = Astro.props;
---

<div class="external-card-final">
  <LinkCard 
    {...props} 
    target="_blank" 
    rel="noopener noreferrer" 
  />
  <div class="custom-overlay">
    <Icon name="external" size="1.2rem" />
  </div>
</div>

<style>
  .external-card-final {
    position: relative;
    display: block;
  }

  .external-card-final :global(.sl-link-card svg) {
    display: none !important;
  }

  .custom-overlay {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    pointer-events: none;
    
    color: var(--sl-color-gray-3); 
    opacity: 0.8;
    
    display: flex;
    transition: all 0.2s ease-in-out;
  }

  .external-card-final:hover .custom-overlay {
    color: var(--sl-color-accent-high);
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .external-card-final :global(.sl-link-card .sl-flex) {
    padding-inline-end: 2.5rem;
  }
</style>