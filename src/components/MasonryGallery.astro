---
// src/components/MasonryGallery.astro
import { Image, getImage } from 'astro:assets';
import '../styles/lightbox.css';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

// Wir verarbeiten alle Bilder vor dem Rendern, um optimierte Versionen für die Lightbox zu erstellen
const optimizedImages = await Promise.all(
  images.map(async (img) => {
    const largeImage = await getImage({
      src: img.src,
      width: 2000,
      format: 'webp',
      quality: 'high'
    });

    return {
      ...img,
      lightboxSrc: largeImage.src,
      lightboxWidth: largeImage.attributes.width,
      lightboxHeight: largeImage.attributes.height,
    };
  })
);
---

<div class="masonry-wrapper pswp-gallery">
  {optimizedImages.map((img) => (
    <figure class="masonry-item">
      <a
        href={img.lightboxSrc}
        data-pswp-width={img.lightboxWidth}
        data-pswp-height={img.lightboxHeight}
        target="_blank"
        class="pswp-link"
      >
        <Image
          src={img.src}
          alt={img.alt}
          width={400}
          quality="mid"
        />
      </a>
      {img.caption && (
        <figcaption class="image-caption" data-pswp-caption>
          {img.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<script>
  import { registerLightbox } from '../scripts/lightbox';

  // `.pswp-gallery` ist eine Klasse, keine ID: PhotoSwipe bindet sich an jedes
  // Vorkommen, sodass mehrere Galerien pro Seite eigene Gruppen bleiben.
  registerLightbox({ gallery: '.pswp-gallery', children: 'a.pswp-link' });
</script>

<style>
  .masonry-wrapper {
    column-count: 3;
    column-gap: 1.5rem;
    width: 100%;
  }

  .masonry-item {
    margin: 0 0 1.5rem;
    display: block;
    break-inside: avoid;
    border-radius: 0.5em;
    background: var(--sl-color-gray-6);
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    transition: transform 0.3s ease;
  }

  .masonry-item:hover {
    transform: translateY(-4px);
    border-color: var(--sl-color-accent);
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    cursor: zoom-in;
  }

  .image-caption {
    padding: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
    border-top: 1px solid var(--sl-color-gray-5);
  }

  @media (max-width: 768px) { .masonry-wrapper { column-count: 2; } }
  @media (max-width: 380px) { .masonry-wrapper { column-count: 1; } }
</style>
