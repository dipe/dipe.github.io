---
// src/components/PhotoSwipeImage.astro
import { Image, getImage } from 'astro:assets';
import '../styles/lightbox.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Caption below the image and in the lightbox. Slot content takes precedence. */
  caption?: string;
  /** Width of the inline image; the lightbox always gets the 2000px version. */
  width?: number;
}

const { src, alt, caption, width = 800 } = Astro.props;
const hasSlot = Astro.slots.has('default');

const optimizedLargeImage = await getImage({
  src: src,
  width: 2000,
  format: 'webp',
  quality: 'high'
});
---
<figure class="pswp-single-wrapper">
  <a
    href={optimizedLargeImage.src}
    data-pswp-width={optimizedLargeImage.attributes.width}
    data-pswp-height={optimizedLargeImage.attributes.height}
    target="_blank"
    class="pswp-trigger"
  >
    <Image src={src} alt={alt} width={width} />
  </a>
  {(hasSlot || caption) && (
    <figcaption class="pswp-caption" data-pswp-caption>
      {hasSlot ? <slot /> : caption}
    </figcaption>
  )}
</figure>

<style>
  .pswp-single-wrapper {
    border-radius: 0.5em;
    background: var(--sl-color-gray-6);
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    transition: transform 0.3s ease;
    display: block;
    margin: 1.5rem 0;
  }
  .pswp-single-wrapper:hover {
    transform: translateY(-4px);
    border-color: var(--sl-color-accent);
  }
  .pswp-single-wrapper a.pswp-trigger {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .pswp-caption {
    padding: 0.5em 0.75em;
    font-size: 0.85em;
    color: var(--sl-color-gray-2);
    text-align: center;
    font-style: italic;
    margin: 0;
  }
</style>

<script>
  import { registerLightbox } from '../scripts/lightbox';

  // `gallery: 'body'` puts every standalone image of a page into one swipeable
  // set, so the lightbox can page through them.
  registerLightbox({ gallery: 'body', children: 'a.pswp-trigger' });
</script>
